{
  "name": "fuskamo-backend",
  "version": "1.0.0",
  "description": "FUSKAMO custom backend — M-Pesa, AI, notifications, queues, and privileged business logic between the Flutter app and Supabase.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/jobs/worker.js",
    "test": "node --test src/tests/*.test.js",
    "test:logic": "node --test src/tests/adminAuthorization.test.js src/tests/discoveryEngine.test.js src/tests/trustBadgeEngine.test.js src/tests/unifiedGraphEngine.test.js src/tests/unifiedGraphEngine.v2.test.js src/tests/videoInfrastructure.test.js src/tests/projectQualityGate.test.js",
    "test:stress": "node ../tools/stress_test.js",
    "test:stress:heavy": "FUSKAMO_STRESS_CANDIDATES=500000 FUSKAMO_STRESS_TRUST=500000 FUSKAMO_STRESS_DISCOVERY=250000 node ../tools/stress_test.js",
    "test:platform": "node --test src/tests/platformIntelligence.test.js",
    "test:all": "node --test src/tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "rotating-file-stream": "^3.2.3",
    "dotenv": "^16.4.5",
    "axios": "^1.7.2",
    "jsonwebtoken": "^9.0.2",
    "jose": "^5.9.6",
    "express-rate-limit": "^7.4.0",
    "express-slow-down": "^2.0.3",
    "express-validator": "^7.1.0",
    "sanitize-html": "^2.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "pg": "^8.12.0",
    "node-cache": "^5.1.2",
    "ioredis": "^5.4.1",
    "bullmq": "^5.12.0",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.4",
    "file-type": "^19.3.0",
    "firebase-admin": "^12.3.1",
    "nodemailer": "^6.9.14",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
