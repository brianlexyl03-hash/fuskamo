# ==============================================================================
# FUSKAMO — Flutter app environment
# ==============================================================================
# 1. Copy this file to .env in the project root.
# 2. Fill in the values below — nothing else in this file needs to change.
# 3. .env is gitignored — never commit it with real values.
# Full explanation of every value: docs/production-checklist.md
# ==============================================================================

# ── Supabase (REQUIRED) ───────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Custom backend (REQUIRED) ─────────────────────────────────────────────────
# Your deployed /backend — handles M-Pesa, AI summaries, and admin actions.
# BACKEND_API_KEY must match the same value in backend/.env.
BACKEND_BASE_URL=http://localhost:8080
BACKEND_API_KEY=

# There is no admin config in this app anymore. Admin review (approving
# players/scouts, transactions, audit log, managing other admins) lives
# entirely in admin-web/ — see admin-web/README.md and
# docs/admin-access.md. Every administrator has their own Supabase Auth
# account there; nothing admin-related is baked into this build.

# Public client configuration only
# Never put service-role, JWT secret, DB URL, payment secrets, AI server keys, or Firebase service-account JSON here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
BACKEND_BASE_URL=
BACKEND_API_KEY=

# Player ranking pipeline: V2 enabled by default; set false for rollback.
PLAYER_DISCOVERY_V2=true
