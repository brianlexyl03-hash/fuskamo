# Copy to backend/.env and fill only the values for features you enable.
# Never commit backend/.env.

PORT=8080
NODE_ENV=development
BACKEND_API_KEY=GENERATE_A_LONG_RANDOM_SECRET

# Core server access
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_DB_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING
ADMIN_CONSOLE_URL=https://YOUR_ADMIN_DOMAIN

# Optional: M-Pesa Boost
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR_PUBLIC_BACKEND_DOMAIN/api/mpesa/callback
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Optional: AI scouting notes
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Optional infrastructure
CORS_ALLOWED_ORIGINS=
REDIS_URL=

# Optional push notifications
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional SMS/email delivery
AT_USERNAME=
AT_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Platform intelligence / infrastructure adapters
# Optional distributed cache and queue
REDIS_URL=
# Optional model provider (never expose server API keys to Flutter/web)
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
# Optional observability/export endpoint
OBSERVABILITY_EXPORT_URL=
# Salt used only for server-side irreversible device/IP identifiers
SECURITY_HASH_SALT=
# Public object-storage/CDN origin when video is eventually enabled
MEDIA_CDN_BASE_URL=
